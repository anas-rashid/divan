---
// tag chips (#52): each links to its tag page
const { tags } = Astro.props as { tags: { type: string; name: string; phrase?: string }[] };
const href = (t: { type: string; name: string }) => `/tag/${encodeURIComponent(t.type)}/${encodeURIComponent(t.name)}`;
---
{tags.length > 0 && (
  <p class="tag-chips">{tags.map((t) => <a class="tag-chip" href={href(t)} title={t.phrase ? `«${t.phrase}»` : undefined}>{t.phrase && <span class="tag-phrase">«{t.phrase}»</span>}<small>{t.type}</small> {t.name}</a>)}</p>
)}
