---
// A poet's picture, the same everywhere: the portrait (from Wikimedia, api/src/portraits.ts) in a rounded square, turned to one
// duotone in the palette's colours whatever the original (painting or photograph), in the logo's gold ring; without a
// portrait, the pen name's first letter in Nastaliq on lapis, in the same ring.
interface Props { poet: { id: number; nickname: string; portrait?: string | null; focus?: { x: number; y: number; z: number } | null }; size?: number; class?: string }
const { poet, size = 56, class: cls } = Astro.props;
// the pen name usually comes last (مرزا غالب, میر تقی میر, محمد اقبال): its first letter
// the framing on the face (found by tools/face_focus.py, or set by an admin): the face's point in the picture, and a zoom
const f = poet.focus?.x != null ? poet.focus : null, framed = f ? `--px: ${f.x}; --py: ${f.y}; --z: ${f.z};` : '';
const letter = [...(poet.nickname.trim().split(/\s+/).pop() ?? poet.nickname)][0];
---
{poet.portrait
  ? <span class:list={['poet-avatar', cls, { framed: f }]} style={`--s: ${size}px; ${framed}`}><img src={`/portrait/${poet.id}?v=${poet.portrait.slice(0, 10)}`} alt="" width={size} height={size} loading="lazy" decoding="async" /></span>
  : <span class:list={['poet-avatar', 'generic', cls]} style={`--s: ${size}px`} aria-hidden="true">{letter}</span>}
