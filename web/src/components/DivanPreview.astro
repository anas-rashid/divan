---
// Divan text rendered like the site (moderation preview, guide examples): headings, paragraphs, couplets with
// their labels, lines and stanzas; dictionary links underlined, footnotes numbered, variants marked
import { parse } from '../../../api/src/divantext.ts';
const { text } = Astro.props as { text: string };
const doc = parse(text);
let n = 0;
const notes: string[] = [];
const line = (l: any) => { l.notes.forEach((x: string) => notes.push(x)); return l; };
---
<article class="poem preview">
  {doc.blocks.map((b: any) => b.type === 'heading' ? (b.level > 2 ? <h4 class="mod-h sub">{b.text}</h4> : <h3 class="mod-h">{b.text}</h3>)
    : b.type === 'para' ? <p class="para">{line(b.line).text}{b.line.notes.map(() => <sup>{++n}</sup>)}</p>
    : b.type === 'couplet' ? <div class="couplet" data-mark={b.label}>{b.lines.map((l: any) => <p>{line(l).text}{l.notes.map(() => <sup>{++n}</sup>)}</p>)}</div>
    : <div class={b.type === 'stanza' ? 'stanza' : ''}>{b.lines.map((l: any) => <p class="single">{line(l).text}{l.notes.map(() => <sup>{++n}</sup>)}</p>)}</div>)}
  {notes.length > 0 && <ol class="preview-notes">{notes.map((x) => <li>{x}</li>)}</ol>}
</article>
