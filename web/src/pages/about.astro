---
// About Divan (public): inspiration (Ganjoor), where the content comes from, open source, moderation and plans
import Base from '../layouts/Base.astro';
import { api } from '../lib/api';
import { ud } from '../lib/urdu';

const poets = ((await api<unknown[]>('/api/poets')) ?? []).length;
---
<Base title="دیوان کے بارے میں" description="دیوان: اردو کی کلاسیکی شاعری اور نثر کا مفت اور آزاد ذخیرہ، گنجور سے متاثر">
  <article class="guide about">
    <h1>دیوان کے بارے میں</h1>
    <p>
      دیوان اردو کی کلاسیکی شاعری اور نثر کا ایک مفت اور آزاد (اوپن سورس) ذخیرہ ہے، جو اردو پڑھنے والوں کی خدمت کے لیے
      بنایا جا رہا ہے۔ یہاں ہر کوئی بغیر کسی فیس یا پابندی کے پڑھ، تلاش اور شیئر کر سکتا ہے۔
    </p>

    <h2>گنجور سے تحریک</h2>
    <p>
      دیوان فارسی شاعری کی مشہور ویب سائٹ <a href="https://ganjoor.net" lang="en" dir="ltr">ganjoor.net</a> (گنجور) سے
      متاثر ہو کر بنایا گیا ہے۔ اس کا انداز اور اس کی بہت سی سہولتیں گنجور کی طرز پر ہیں: صدیوں کے لحاظ سے شعرا کی فہرست،
      کتابوں اور ابواب کی ترتیب، تلاش، متن منتخب کرنے پر معنی، کاپی اور شیئر کا مینو، اور پسندیدہ کلام محفوظ کرنا۔
      گنجور کی طرح دیوان بھی اوپن سورس ہے۔ دیوان گنجور کا حصہ نہیں بلکہ اردو کے لیے ایک الگ اور آزاد منصوبہ ہے۔
      ہم گنجور بنانے والوں کے شکر گزار ہیں جنھوں نے اپنا کام سب کے لیے کھلا رکھا۔
    </p>

    <h2>مواد کہاں سے آیا</h2>
    <p>
      ابتدائی مواد <a href="https://ur.wikisource.org">اردو ویکی ماخذ</a> سے لیا گیا ہے: {ud(poets)} شعرا و ادبا کی
      گیارہ ہزار سے زیادہ تخلیقات، جو عوامی ملکیت میں ہیں۔ شعرا کے تعارف <a href="https://ur.wikipedia.org">اردو ویکیپیڈیا</a>
      سے ہیں، اور الفاظ کے معنی، تلفظ اور اشتقاق <a href="https://en.wiktionary.org">ویکی لغت</a> (اردو، فارسی اور عربی) سے۔
      ہر کلام کے صفحے پر اس کے ماخذ کا ربط موجود ہے، اور ویکی ماخذ کی نئی تبدیلیاں روزانہ یہاں آتی ہیں۔
    </p>
    <p>
      جن شعرا نے اردو کے ساتھ فارسی میں بھی کہا، جیسے اقبال، غالب اور امیر خسرو، ان کا فارسی کلام
      <a href="https://ganjoor.net">گنجور</a> کے کھلے ڈیٹا سے لیا گیا ہے، اور ہر ایسے کلام پر گنجور کا حوالہ اور ربط ہے۔
      اس کے لیے ہم گنجور کے شکر گزار ہیں۔ دیوان گنجور کی کوئی سرکاری ایپ یا اس کا حصہ نہیں، نہ گنجور اس کی تائید کرتا ہے۔
    </p>

    <h2>آزاد اور اوپن سورس</h2>
    <p>
      دیوان کا <a href="https://github.com/anas-rashid/divan">کوڈ</a> اور <a href="https://github.com/anas-rashid/divan-data">ڈیٹا</a>
      دونوں کھلے ہیں۔ متن عوامی ملکیت میں ہے، اس لیے اسے پڑھنا، نقل کرنا اور آگے بانٹنا سب کے لیے آزاد ہے۔ ویکی لغت کا مواد
      اپنے لائسنس <bdi dir="ltr">CC BY-SA</bdi> کے تحت ہے۔ مقصد یہ ہے کہ اردو کا کلاسیکی ادب کسی ایک ادارے کی ملکیت نہ رہے بلکہ سب کا مشترکہ
      سرمایہ بنے۔
    </p>

    <h2>ماڈریٹر اور دیوان کا اپنا نسخہ</h2>
    <p>
      دیوان صرف ویکی ماخذ کی نقل نہیں رہے گا۔ ماڈریٹر کلاسیکی اردو مواد کی تصحیح، اضافہ اور ترتیب کرتے ہیں: کسی مصرعے کی
      غلطی درست کرنا، مطلع اور مقطع کی نشان دہی، الفاظ کو لغت سے جوڑنا، حاشیے اور نسخوں کے فرق لکھنا، اور کسی دیوان کی غزلوں یا
      کسی کتاب کی نظموں کو مطبوعہ ترتیب میں لانا۔ ہر تبدیلی جائزے کے مراحل سے گزرتی ہے، اور منظور ہونے کے بعد دیوان کا اپنا نسخہ
      ویکی ماخذ کے متن پر ترجیح پاتا ہے۔
    </p>
    <p>
      ہر شائع شدہ تبدیلی ڈیٹا کے کھلے ذخیرے میں درج ہوتی ہے، کس نے کی، کس نے منظور کی اور کب، تاکہ ہر لفظ کی تاریخ سب کے
      سامنے رہے۔ کلام کے صفحے کے آخر میں دیوان کا ورژن اور اس کی تبدیلی کا ربط نظر آتا ہے۔
    </p>

    <h2>نئے لکھنے والوں کے لیے</h2>
    <p>
      آگے چل کر دیوان نئے شاعروں، ادیبوں اور مصنفین کا گھر بھی ہوگا، جہاں وہ اپنی تخلیقات اسی احترام اور اسی انداز سے پیش کر سکیں
      جیسے کلاسیکی ادب۔ یوں کلاسیکی روایت اور آج کا اردو ادب ایک ہی جگہ ملیں گے۔
    </p>

    <h2>آگے کیا ہے</h2>
    <ul>
      <li>ماڈریٹروں کے لیے شعرا، تعارف، کتابوں اور لغت کی ترمیم، اور دستاویزات (docx، odt، txt) سے متن لانا</li>
      <li>موضوعات اور ٹیگ، اور ان سے تلاش</li>
      <li>ویکی لغت کی طرز پر دیوان کا اپنا لغت کا حصہ</li>
      <li>قارئین کے تبصرے، اور کلام کی آواز میں قرأت</li>
      <li>موبائل ایپس کے لیے کھلا API</li>
    </ul>

    <h2>شامل ہوں</h2>
    <p>
      <a href="/signup">اکاؤنٹ بنائیں</a> تو پسندیدہ شعرا، کلام، اشعار اور عبارتیں محفوظ کر سکتے ہیں اور اپنا ذخیرۂ الفاظ بنا
      سکتے ہیں۔ ماڈریٹر ایڈمن مقرر کرتے ہیں؛ اگر آپ کلاسیکی اردو کی خدمت میں ہاتھ بٹانا چاہتے ہیں تو اکاؤنٹ بنا کر ہم سے رابطہ کریں۔
      ماڈریٹروں کے لیے <a href="/mod/guide">لکھنے کا طریقہ</a> یہاں ہے۔
    </p>
  </article>
</Base>
