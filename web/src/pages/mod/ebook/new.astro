---
// Add an e-book to a poet (moderators with the e-books permission for that poet): a file (PDF, EPUB, TXT, DOCX up to
// 100 MB) or an archive.org link, with its title, source and copyright; it goes for review like any other change
import Base from '../../../layouts/Base.astro';
import ModNav from '../../../components/ModNav.astro';
import { asUser, COOKIE } from '../../../lib/auth';
import { api } from '../../../lib/api';
import EbookFields from '../../../components/EbookFields.astro';

const me = Astro.locals.user;
if (!me) return Astro.redirect(`/signin?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`);
const token = Astro.cookies.get(COOKIE)!.value, API = process.env.API_URL ?? 'http://127.0.0.1:4100';
const poetId = Number(Astro.url.searchParams.get('poet')) || 0;
const page = poetId ? await api(`/api/page?url=${encodeURIComponent(`/p${poetId}`)}`) : null;
const may = page && ['mod-l2', 'mod-l1', 'admin'].includes(me.role) && (await asUser(token, `/api/mod/can?category=${page.category.id}`)).data.ebooks;
let error = '';
if (may && Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const fields = Object.fromEntries(['title', 'writer', 'coauthors', 'language', 'direction', 'tags', 'source', 'licence', 'note'].map((k) => [k, f.get(k) ?? '']));
  Object.assign(fields, { poet: poetId });
  const upload = f.get('file') as File | null, archive = String(f.get('archive') ?? '').trim();
  let body: object | null = null;
  if (archive) body = { ...fields, archive };
  else if (upload && upload.size) {
    const res = await fetch(`${API}/api/mod/ebooks/upload?poet=${poetId}&name=${encodeURIComponent(upload.name)}`, {
      method: 'POST', headers: { authorization: `Bearer ${token}`, 'content-type': 'application/octet-stream' }, body: upload.stream(), duplex: 'half',
    } as RequestInit);
    const up = await res.json().catch(() => ({}));
    if (res.ok) body = { ...fields, file: up.file }; else error = up.error ?? 'فائل اپ لوڈ نہیں ہوئی';
  } else error = 'فائل چنیں یا archive.org کا ربط دیں';
  if (body) {
    const r = await asUser(token, '/api/mod/ebooks', body);
    // the cover: made in the browser from the PDF's first page or the EPUB's cover, or the moderator's own image
    const cover = f.get('cover') as File | null;
    if (r.ok && cover && cover.size) await fetch(`${API}/api/mod/ebooks/${r.data.id}/cover`, {
      method: 'POST', headers: { authorization: `Bearer ${token}`, 'content-type': 'application/octet-stream' }, body: await cover.arrayBuffer(),
    });
    if (r.ok) return Astro.redirect(`/mod/rev/${r.data.revision}`);
    error = r.data.error ?? 'کچھ غلط ہو گیا';
  }
}
---
<Base title="ای بک شامل کریں">
  <h1>ای بک شامل کریں</h1>
  <ModNav />
  {!may ? <p class="form-error center" role="alert">اس شاعر کی ای بکس شامل کرنے کی اجازت نہیں۔</p> : (
    <form method="post" enctype="multipart/form-data" class="account-form ebook-form">
      <p class="center">شاعر: <a href={page.poet.url}>{page.poet.nickname}</a></p>
      {error && <p class="form-error" role="alert">{error}</p>}
      <label>فائل (PDF، EPUB، TXT یا DOCX؛ زیادہ سے زیادہ ۱۰۰ میگا بائٹ)<input type="file" name="file" accept=".pdf,.epub,.txt,.docx,application/pdf,application/epub+zip,text/plain" /></label>
      <label>سرورق (PDF کے پہلے صفحے یا EPUB کے سرورق سے خود بنتا ہے؛ چاہیں تو اپنی تصویر چنیں)
        <input type="file" name="cover" accept="image/jpeg,image/png,image/webp" /></label>
      <img class="cover-small" id="cover-preview" alt="سرورق" hidden />
      <label>یا archive.org کا ربط<input name="archive" dir="ltr" placeholder="https://archive.org/details/…" /></label>
      <EbookFields v={{ writer: page.poet.nickname }} />
      <p class="muted note">کتاب جائزے کے بعد شاعر کے صفحے پر «ای بکس» میں نظر آئے گی۔ جائزہ لینے والے حقوق کی تصدیق کرتے ہیں۔</p>
      <button>اپ لوڈ کریں</button>
    </form>
  )}
  <script>
    import { makeCover } from '../../../lib/cover';
    const form = document.querySelector<HTMLFormElement>('.ebook-form');
    if (form) {
      const book = form.querySelector<HTMLInputElement>('[name=file]')!, cover = form.querySelector<HTMLInputElement>('[name=cover]')!;
      const preview = document.getElementById('cover-preview') as HTMLImageElement;
      let own = false; // a picture the moderator chose themselves is never replaced
      const showCover = (f: Blob) => { preview.src = URL.createObjectURL(f); preview.hidden = false; };
      cover.addEventListener('change', () => { own = !!cover.files?.length; if (own) showCover(cover.files![0]); });
      book.addEventListener('change', async () => {
        const f = book.files?.[0], kind = f?.name.toLowerCase().endsWith('.pdf') ? 'pdf' : f?.name.toLowerCase().endsWith('.epub') ? 'epub' : null;
        if (!f || !kind || own) return;
        const blob = await makeCover(await f.arrayBuffer(), kind).catch(() => null);
        if (!blob || own) return;
        const dt = new DataTransfer(); dt.items.add(new File([blob], 'cover.jpg', { type: blob.type || 'image/jpeg' }));
        cover.files = dt.files; showCover(blob);
      });
    }
  </script>
</Base>
