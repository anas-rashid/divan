@model GanjooRazor.Pages._GroupedByDateViewPartialModel
@switch (Model.DataType)
{
    case "poemcorrections":
        <text>
            <p>
                قابلیت ویرایش متن از اواسط سال ۱۴۰۰ به دیوان افزوده شده است و به صورت دو مرحله‌ای (ویرایش و بعد تأیید یا رد ویرایش) کار می‌کند. ویرایش می‌تواند شامل متن، معنی یا وزن و حروف قافیه و قالب و زبان غالب و ... باشد. جزئیات ویرایش‌های کاربران با نام آنها منتشر نمی‌شود. یک ویرایش می‌تواند شامل یک یا چند ویرایش جزئی باشد از این جهت حجم کار انجام شده از لحاظ تعداد جزئیات تغییر یافته چند برابر این اعداد است. این آمار نشان‌دهندهٔ تعداد ویرایش‌های کلی تأیید شده است. در صورتی که کاربری حساب کاربری خود را حذف کند تاریخچهٔ ویرایش‌های او به حساب «کاربر سیستمی حذف‌شده» منتقل می‌شود.
            </p>
        </text>
        break;
    case "sectioncorrections":
        <text>
            <p>
                ویرایش قطعات همانند ویرایش متن است. در متون مخلوط نظم و نثر برای تعیین وزن و قافیه باید مشخص شود که وزن و قافیه مربوط به کدام قطعهٔ بخش است. این کار را با ویرایش قطعه انجام می‌دهیم. به دلایل فنی امکان یکی کردن آمار این ویرایش‌ها با ویرایش‌های عادی وجود ندارد. ویرایش‌های قطعات هم به صورت دو مرحله‌ای (ویرایش و بعد تأیید یا رد ویرایش) انجام می‌شود. جزئیات ویرایش‌های کاربران با نام آنها منتشر نمی‌شود. یک ویرایش قطعه نیز می‌تواند شامل یک یا چند ویرایش جزئی باشد از این جهت حجم کار انجام شده از لحاظ تعداد جزئیات تغییر یافته چند برابر این اعداد است. این آمار نشان‌دهندهٔ تعداد ویرایش‌های قطعات کلی تأیید شده است. در صورتی که کاربری حساب کاربری خود را حذف کند تاریخچهٔ ویرایش‌های قطعات او به نام حساب کاربر سیستمی حذف‌شده منتقل می‌شود.
            </p>
        </text>
        break;
    case "catcorrections":
        <text>
            <p>
                ویرایش بخش برای ویرایش زندگینامهٔ سخنوران و همینطور توضیحات اضافی زیربخش‌ها کاربرد دارد و به صورت دو مرحله‌ای (ویرایش و بعد تأیید یا رد ویرایش) انجام می‌شود. جزئیات ویرایش‌های کاربران با نام آنها منتشر نمی‌شود. این آمار نشان‌دهندهٔ تعداد ویرایش‌های بخش‌های تأیید شده است. در صورتی که کاربری حساب کاربری خود را حذف کند تاریخچهٔ ویرایش‌های بخش او به نام حساب کاربر سیستمی حذف‌شده منتقل می‌شود.
            </p>
        </text>
        break;
    case "suggestedsongs":
        <text>
            <p>
                سابقهٔ پیشنهاد ترانه‌های مرتبط با اشعار به پیش از افزوده شدن امکان نام‌نویسی کاربران به دیوان برمی‌گردد (پیشنهاد ترانه بدون ورود به دیوان و به شکل بی‌نام انجام می‌شده). از این جهت تعداد ۴٬۶۸۲ ترانهٔ پیشنهادی تأیید شده (داخل در آمار زیر) فاقد اطلاعات کاربر پیشنهاد دهنده است.  جزئیات ترانه‌های پیشنهادی کاربران با نام آنها منتشر نمی‌شود. این آمار نشان‌دهندهٔ تعداد ترانه‌های مرتبط تأیید شده است. در صورتی که کاربری حساب کاربری خود را حذف کند تاریخچهٔ ترانه‌های پیشنهادی او به نام حساب کاربر سیستمی حذف‌شده منتقل می‌شود.
            </p>
        </text>
        break;
    case "quoteds":
    <text>
        <p>
                مشق شعر نقل قول اشعار شاعران از اشعار دیگر و یا اشعار خودشان است. جزئیات مشق شعرهای پیشنهادی کاربران با نام آنها منتشر نمی‌شود. این آمار نشان‌دهندهٔ تعداد مشق شعرهای تأیید شده است. در صورتی که کاربری حساب کاربری خود را حذف کند تاریخچهٔ مشق شعرهای او به نام حساب کاربر سیستمی حذف‌شده منتقل می‌شود.
        </p>
    </text>
        break;
    case "discussions":
    <text>
        <p>
                <a href="/hashieha/">حاشیه‌ها</a> دیدگاه‌های ثبت شدهٔ کاربران دیوان است. سابقهٔ امکان درج حاشیه در دیوان به ۱۴ سال پیش از افزوده شدن امکان نام‌نویسی در دیوان برمی‌گردد و پیش از آن کاربران می‌توانستند حتی بدون وارد کردن نامشان در دیوان حاشیه‌نویسی کنند. بعد از افزوده شدن امکان نام‌نویسی اگر کاربر با ایمیلی ثبت نام کند که پیش از آن با همان ایمیل حاشیه‌ای در دیوان ثبت کرده باشد مالکیت آن حاشیه(ها) به او منتقل می‌شود. در صورتی که کاربری حساب کاربری خود را حذف کند حاشیه‌های او هم به طور کامل حذف می‌شود.
        </p>
    </text>
        break;
    case "recitations":
    <text>
        <p>
                امکان روخوانی متون دیوان پیش از افزوده شدن امکان نام‌نویسی در دیوان وجود داشته و شیوهٔ انتشار روخوانی‌ها آن بوده که خوانشگر روخوانی را با ایمیل یا روش‌های ارتباطی دیگر برای گردانندهٔ دیوان می‌فرستاده که بعدها به دلیل حجم بالای ورودی‌ها این روش منقضی شد و سیستمی برای آن ارائه شد. یک کاربر می‌تواند با تعریف نمایه‌های متعدد روخوانی‌های افراد مختلفی را منتشر کند. لذا لزوماً همهٔ خوانش‌های کاربر متعلق به خود او نیست. در صورت حذف حساب کاربری کلیهٔ خوانش‌های متعلق به کاربر حذف می‌شوند.
        </p>
    </text>
        break;
    case "museumlinks":
    <text>
        <p>
                سیستم پیشنهاد تصاویر نسخه‌های خطی مرتبط با متون دیوان پیش از افزوده شدن امکان نام‌نویسی در دیوان ارائه شده و همان سیستم مدیریت کاربران و کاربران آن بعدها برای دیوان استفاده شده است. در صورت حذف حساب کاربری سوابق کلیهٔ ارتباطات پیشنهادی به حساب سیستمی کاربر حذف شدهٔ دیوان منتقل می‌شود.
        </p>
    </text>
        break;
    case "pinterestlinks":
    <text>
        <p>
                تصاویر خارجی تصاویر نگاره‌ها و صفحات نسخه‌های نفیس است که در گنجینهٔ دیوان میزبانی نمی‌شود. در صورت حذف حساب کاربری سوابق کلیهٔ ارتباطات پیشنهادی به حساب سیستمی کاربر حذف شدهٔ دیوان منتقل می‌شود.
        </p>
    </text>
        break;
    case "poetspeclines":
    <text>
        <p>
                کاربران دیوان می‌توانند برای چهره‌های شاعران دیوان نکاتی را پیشنهاد دهند. در نسخه‌های اولیه تاریخ ثبت یا تأیید پیشنهاد ذخیره نمی‌شده و از این جهت تعدادی از  موارد پیشنهادی بدون تاریخ هستند. در صورت حذف حساب کاربری سوابق کلیهٔ نکات پیشنهادی به حساب سیستمی کاربر حذف شدهٔ دیوان منتقل می‌شود.
        </p>
    </text>
        break;
    case "poetpix":
    <text>
        <p>
                کاربران دیوان می‌توانند برای چهره‌های شاعران دیوان تصاویری را پیشنهاد دهند. در نسخه‌های اولیه تاریخ ثبت یا تأیید پیشنهاد ذخیره نمی‌شده و از این جهت تعدادی از  موارد پیشنهادی بدون تاریخ هستند. در صورت حذف حساب کاربری سوابق کلیهٔ تصاویر پیشنهادی به حساب سیستمی کاربر حذف شدهٔ دیوان منتقل می‌شود.
        </p>
    </text>
        break;
    case "usernotes":
    <text>
        <p>
                کاربران گنجینهٔ دیوان می‌توانند روی نسخه‌های در دسترس روی آن یا تصاویر آنها یادداشتهایی را به شکل عمومی بنویسند. در صورت حذف حساب کاربری این یادداشتها نیز پاک می‌شوند.
        </p>
    </text>
        break;
    case "users":
    <text>
        <p>
                آمار کاربران دیوان را برای نسبت‌گیری تعداد کاربران مشارکت‌کننده و همینطور مشاهدهٔ روند نام‌نویسی آنها در دسترس گذاشته‌ایم.
        </p>
    </text>
        break;

}
@if (Model.Summary != null)
{
    @if (Model.DataType == "users")
    {
        <div class="stats-section-no-grid">
            <div class="stat-item">
                <div class="stat-value" id="totalCorrections">@RMuseum.Services.Implementation.LanguageUtils.FormatMoney(Model.Summary.TotalCount)</div>
                <div class="stat-label">
                    تعداد کل
                </div>
            </div>
        </div>

    }
    else
    {
        <div class="stats-section">
            <div class="stat-item">
                <div class="stat-value" id="totalDays">@RMuseum.Services.Implementation.LanguageUtils.FormatMoney(Model.Summary.Days)</div>
                <div class="stat-label">روز مشارکت</div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="totalCorrections">@RMuseum.Services.Implementation.LanguageUtils.FormatMoney(Model.Summary.TotalCount)</div>
                <div class="stat-label">
                    تعداد کل مشارکت‌ها
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-value" id="totalUsers">@RMuseum.Services.Implementation.LanguageUtils.FormatMoney(Model.Summary.UserIds)</div>
                <div class="stat-label">کاربران مشارکت کننده</div>
            </div>
        </div>

    }
}

<partial name="_GroupedByDateViewTablePartial.cshtml" model="Model.TableModel" />
