# Copy to .env and fill in. DNS A records for both domains must point at this server.
SITE_DOMAIN=divan.example.com
API_DOMAIN=api.divan.example.com

# SQL Server: 8+ chars with upper, lower, digit and symbol
MSSQL_SA_PASSWORD=
# JWT signing key: generate with `openssl rand -base64 32`
JWT_SECRET=
# First login with this email (any valid password) becomes the admin
ADMIN_EMAIL=

# Public sign-up needs SMTP (SmptConfig__* env vars); keep off until configured
SIGNUP_ENABLED=False
