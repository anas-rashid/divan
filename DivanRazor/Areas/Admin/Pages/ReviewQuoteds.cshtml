@page
@using DNTPersianUtils.Core
@model DivanRazor.Areas.Admin.Pages.ReviewQuotedsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "بازبینی مشق‌شعرهای پیشنهادی";
}
<div class="up-page-header">
    <h1>@ViewData["Title"]</h1>
</div>

@if (!string.IsNullOrEmpty(Model.FatalError))
{
    <div class="up-alert up-alert--danger">@Model.FatalError</div>
}
else if (Model.DivanQuotedPoem == null)
{
    <partial name="_EmptyState" model="@("پیشنهادی وجود ندارد.")" />
}
else
{
    <div class="up-card">
        <p class="up-hint">تعداد کل: @Model.TotalCount</p>
        <div class="up-field">
            <label>پیشنهاد دهنده</label>
            <div class="up-field-static"><a href="/user/edits/?allusers=1&userid=@Model.DivanQuotedPoem.SuggestedById" target="_blank">@Model.SuggestedBy.NickName</a></div>
        </div>

        <form method="post" class="up-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ModerationModel.Id" />
            <div class="up-field">
                <label asp-for="ModerationModel.Approved">تأیید می‌شود؟</label>
                <input asp-for="ModerationModel.Approved" />
            </div>
            <div class="up-field">
                <label asp-for="ModerationModel.ReviewNote">یادداشت بررسی</label>
                <textarea asp-for="ModerationModel.ReviewNote" rows="4"></textarea>
            </div>
            <div class="up-form-actions">
                <button type="submit" class="up-btn up-btn--success">بررسی</button>
                <a href="/Admin/ReviewQuoteds?skip=@(Model.Skip + 1)" role="button" class="up-btn up-btn--ghost">بعدی</a>
            </div>
        </form>
    </div>

    <div class="up-card">
        <h2 class="up-card__title">بیت مرجع از <a href="/?p=@Model.DivanQuotedPoem.PoemId">شعر</a></h2>

        @if (Model.DivanQuotedPoem.CoupletIndex != null && Model.DivanQuotedPoem.CoupletIndex != -1)
        {
            <p>@($"{(Model.Couplets[(int)Model.DivanQuotedPoem.CoupletIndex].Item1 + 1).ToPersianNumbers()} - {Model.Couplets[(int)Model.DivanQuotedPoem.CoupletIndex].Item2}")</p>
        }

        <div class="up-field">
            <label>مصرع اول مهم است</label>
            <input type="checkbox" disabled @(Model.DivanQuotedPoem.CoupletVerse1ShouldBeEmphasized ? "checked=\"checked\"" : "") />
        </div>
        <div class="up-field">
            <label>مصرع دوم مهم است</label>
            <input type="checkbox" disabled @(Model.DivanQuotedPoem.CoupletVerse2ShouldBeEmphasized ? "checked=\"checked\"" : "") />
        </div>
        <div class="up-field">
            <label>شاعر مرجع</label>
            <div class="up-field-static">@Model.DivanQuotedPoem.PoetId</div>
        </div>

        @if (Model.DivanQuotedPoem.RelatedPoemId != null)
        {
            <p><a href="/?p=@Model.DivanQuotedPoem.RelatedPoemId" class="up-btn up-btn--ghost up-btn--sm">مشاهدهٔ شعر مرتبط</a></p>
        }

        <div class="up-field">
            <label>بیت مرتبط</label>
            @if (Model.DivanQuotedPoem.RelatedCoupletIndex != null && Model.DivanQuotedPoem.RelatedCoupletIndex != -1)
            {
                if (Model.DivanQuotedPoem.RelatedCoupletIndex < Model.RelatedCouplets.Length)
                {
                    <p>@($"{(Model.RelatedCouplets[(int)Model.DivanQuotedPoem.RelatedCoupletIndex].Item1 + 1).ToPersianNumbers()} - {Model.RelatedCouplets[(int)Model.DivanQuotedPoem.RelatedCoupletIndex].Item2}")</p>
                }
                else
                {
                    <p class="red-color">خطا</p>
                }
            }
        </div>

        <div class="up-field">
            <label>مصرع اول مرتبط (خارج از دیوان)</label>
            <div class="up-field-static">@Model.DivanQuotedPoem.RelatedCoupletVerse1</div>
        </div>
        <div class="up-field">
            <label>مصرع اول مهم است</label>
            <input type="checkbox" disabled @(Model.DivanQuotedPoem.RelatedCoupletVerse1ShouldBeEmphasized ? "checked=\"checked\"" : "") />
        </div>
        <div class="up-field">
            <label>مصرع دوم مرتبط (خارج از دیوان)</label>
            <div class="up-field-static">@Model.DivanQuotedPoem.RelatedCoupletVerse2</div>
        </div>
        <div class="up-field">
            <label>مصرع دوم مهم است</label>
            <input type="checkbox" disabled @(Model.DivanQuotedPoem.RelatedCoupletVerse2ShouldBeEmphasized ? "checked=\"checked\"" : "") />
        </div>
        <div class="up-field">
            <label>ترتیب</label>
            <div class="up-field-static">@Model.DivanQuotedPoem.SortOrder</div>
        </div>
        <div class="up-field">
            <label>این شعر قدیمی‌تر از شعر مرتبط است</label>
            <input type="checkbox" disabled @(Model.DivanQuotedPoem.IsPriorToRelated ? "checked=\"checked\"" : "") />
        </div>
        <div class="up-field">
            <label>منتسب به هر دو شاعر</label>
            <input type="checkbox" disabled @(Model.DivanQuotedPoem.ClaimedByBothPoets ? "checked=\"checked\"" : "") />
        </div>
        <div class="up-field">
            <label>شاعر</label>
            <div class="up-field-static">@Model.DivanQuotedPoem.RelatedPoetId - @Model.DivanQuotedPoem.CachedRelatedPoemPoetName</div>
        </div>
        <div class="up-field">
            <label>سالمرگ شاعر</label>
            <div class="up-field-static">@Model.DivanQuotedPoem.CachedRelatedPoemPoetDeathYearInLHijri</div>
        </div>
        <div class="up-field up-field--ltr">
            <label>نشانی صفحهٔ شاعر</label>
            <div class="up-field-static"><a href="@Model.DivanQuotedPoem.CachedRelatedPoemPoetUrl">@Model.DivanQuotedPoem.CachedRelatedPoemPoetUrl</a></div>
        </div>
        <div class="up-field">
            <label>تصویر شاعر</label>
            <img src="@($"{DivanRazor.APIRoot.InternetUrl}{Model.DivanQuotedPoem.CachedRelatedPoemPoetImage}")" style="max-width:200px;" />
        </div>
        <div class="up-field">
            <label>عنوان شعر</label>
            <div class="up-field-static">@Model.DivanQuotedPoem.CachedRelatedPoemFullTitle</div>
        </div>
        <div class="up-field up-field--ltr">
            <label>نشانی شعر</label>
            <div class="up-field-static"><a href="@Model.DivanQuotedPoem.CachedRelatedPoemFullUrl">@Model.DivanQuotedPoem.CachedRelatedPoemFullUrl</a></div>
        </div>
        <div class="up-field">
            <label>یادداشت</label>
            <div class="up-field-static">@Model.DivanQuotedPoem.Note</div>
        </div>
    </div>
}
