@page
@model DivanRazor.Areas.User.Pages.MySuggestedQuotesModel
@{
    Layout = "_UserPanelLayout";
    ViewData["Title"] = "مشق‌های پیشنهادی من";
    await DivanRazor.Utils.DivanSessionChecker.ApplyPermissionsToViewData(Request, Response, ViewData);
}
<div class="up-page-header">
    <h1>@ViewData["Title"]</h1>
</div>
@if (Model.LastError != "")
{
    <div class="up-alert up-alert--danger">@Model.LastError</div>
}
else
{
    <partial name="_Pagination" model="Model.PaginationLinks" />

    @if (Model.SuggestedQuotes.Count == 0)
    {
        <partial name="_EmptyState" model="@("شما هنوز هیچ مشق شهری را پیشنهاد نداده‌اید.")" />
    }

    @foreach (var DivanQuotedPoem in Model.SuggestedQuotes)
    {
        <div class="up-list-item" id="bookmark-@DivanQuotedPoem.Id">

            @if (DivanQuotedPoem.Rejected)
            {
                <span class="up-badge up-badge--danger">رد شده</span>
            }
            else if (DivanQuotedPoem.Published)
            {
                <span class="up-badge up-badge--success">تأیید شده</span>
            }
            else
            {
                <span class="up-badge up-badge--primary">بررسی نشده</span>
            }

            @if (DivanQuotedPoem.Rejected)
            {
                <p>
                    دلیل رد: @DivanQuotedPoem.ReviewNote
                </p>
            }

            <table>

                <tr>
                    <td>
                        <a href="/?p=@DivanQuotedPoem.PoemId">شعر مرجع</a>:
                    </td>
                </tr>

                <tr>
                    <td>
                        شاعر مرجع:
                    </td>
                </tr>
                <tr>
                    <td>
                        <p>@DivanQuotedPoem.PoetId</p>
                    </td>
                </tr>

                @if (DivanQuotedPoem.RelatedPoemId != null)
                {
                    <tr>
                        <td>
                            <a href="/?p=@DivanQuotedPoem.RelatedPoemId">مشاهدهٔ شعر مرتبط</a>
                        </td>
                    </tr>
                }

                <tr>
                    <td>
                        مصرع اول مرتبط (خارج از دیوان):
                    </td>
                </tr>
                <tr>
                    <td>
                        <p>@DivanQuotedPoem.RelatedCoupletVerse1</p>
                    </td>
                </tr>
                <tr>
                    <td>
                        مصرع اول مهم است:
                    </td>
                </tr>
                <tr>
                    <td>
                        <input type="checkbox" disabled @(DivanQuotedPoem.RelatedCoupletVerse1ShouldBeEmphasized ? "checked=\"checked\"" : "") />
                    </td>
                </tr>
                <tr>
                    <td>
                        مصرع دوم مرتبط (خارج از دیوان):
                    </td>
                </tr>
                <tr>
                    <td>
                        <p>@DivanQuotedPoem.RelatedCoupletVerse2</p>
                    </td>
                </tr>

                <tr>
                    <td>
                        مصرع دوم مهم است:
                    </td>
                </tr>
                <tr>
                    <td>
                        <input type="checkbox" disabled @(DivanQuotedPoem.RelatedCoupletVerse2ShouldBeEmphasized ? "checked=\"checked\"" : "") />
                    </td>
                </tr>

                <tr>
                    <td>
                        منتسب به هر دو شاعر:
                    </td>
                </tr>
                <tr>
                    <td>
                        <input type="checkbox" disabled @(DivanQuotedPoem.ClaimedByBothPoets ? "checked=\"checked\"" : "") />
                    </td>
                </tr>
                <tr>
                    <td>
                        شاعر:
                    </td>
                </tr>
                <tr>
                    <td>
                        <p>@DivanQuotedPoem.CachedRelatedPoemPoetName</p>
                    </td>
                </tr>
                <tr>
                    <td>
                        سالمرگ شاعر:
                    </td>
                </tr>
                <tr>
                    <td>
                        <p>@DivanQuotedPoem.CachedRelatedPoemPoetDeathYearInLHijri</p>
                    </td>
                </tr>
                <tr>
                    <td>
                        نشانی صفحهٔ شاعر:
                    </td>
                </tr>
                <tr>
                    <td>
                        <a href="@DivanQuotedPoem.CachedRelatedPoemPoetUrl">@DivanQuotedPoem.CachedRelatedPoemPoetUrl</a>
                    </td>
                </tr>
                <tr>
                    <td>
                        تصویر شاعر:
                    </td>
                </tr>
                <tr>
                    <td>
                        <img src="@($"{DivanRazor.APIRoot.InternetUrl}{DivanQuotedPoem.CachedRelatedPoemPoetImage}")" />
                    </td>
                </tr>
                <tr>
                    <td>
                        عنوان شعر:
                    </td>
                </tr>
                <tr>
                    <td>
                        <p>@DivanQuotedPoem.CachedRelatedPoemFullTitle</p>
                    </td>
                </tr>
                <tr>
                    <td>
                        نشانی شعر:
                    </td>
                </tr>
                <tr>
                    <td>
                        <a href="@DivanQuotedPoem.CachedRelatedPoemFullUrl">@DivanQuotedPoem.CachedRelatedPoemFullUrl</a>
                    </td>
                </tr>

                <tr>
                    <td>
                        یادداشت:
                    </td>
                </tr>
                <tr>
                    <td>
                        <p>@DivanQuotedPoem.Note</p>
                    </td>
                </tr>

            </table>
        </div>
    }

    <partial name="_Pagination" model="Model.PaginationLinks" />
}
