@page
@model DivanRazor.Pages.ContribsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "دیوان » صارفین کی شراکتیں";
}
@section Head {
    <script src="/js/chart.js"></script>
}
@if (!string.IsNullOrEmpty(Model.LastError))
{
    @Html.Raw(Model.LastError)
}
else
{
<partial name="_SearchHeaderPartial" model="@(new _SearchHeaderPartialModel(){ Poets = Model.Poets, SelectedPoetId = Model.PoetId, CurrentCategory = Model.Poet?.Cat })" />

        <!-- #hdr2 -->

        <div id="fa">

            <partial name="_InlineLoginPartial" model="Model" />

            <div id="maincnt">
                <div class="poem">
                    <h2>
                        <a href="/contribs">صارفین کی شراکتیں</a>
                    </h2>
                    <p>
                        یہ اعداد صرف رکنیت کے ذریعے براہِ راست کی گئی شراکتیں دکھاتے ہیں، تمام شراکتیں نہیں۔ دیگر شراکتوں کے لیے صفحات <a href="/sources">مآخذ</a>، <a href="/donate">مالی معاونت</a> اور <a href="https://github.com/ganjoor/">دیوان کا کوڈ</a> دیکھیں.
                    </p>
                    <p>
                        نیچے کے اعداد میں شراکت کے دن کوئی مدت نہیں بلکہ ان دنوں کی تعداد ہے جن میں شراکت ہوئی۔ اعداد روزانہ تازہ ہوتے ہیں اس لیے ایک دن پیچھے ہو سکتے ہیں.
                    </p>
                    <div class="poemtab" id="tab-items">
                        <div class="poemtablinks" id="poemcorrections"><a role="button" class="actionlink" onclick="loadContributions('poemcorrections')">متن کی ترامیم</a></div>
                        <div class="poemtablinks" id="sectioncorrections"><a role="button" class="actionlink" onclick="loadContributions('sectioncorrections')">حصوں کی ترامیم</a></div>
                        <div class="poemtablinks" id="catcorrections"><a role="button" class="actionlink" onclick="loadContributions('catcorrections')">زمروں کی ترامیم</a></div>
                        <div class="poemtablinks" id="suggestedsongs"><a role="button" class="actionlink" onclick="loadContributions('suggestedsongs')">متعلقہ گیت</a></div>
                        <div class="poemtablinks" id="quoteds"><a role="button" class="actionlink" onclick="loadContributions('quoteds')">مشقِ سخن</a></div>
                        <div class="poemtablinks" id="discussions"><a role="button" class="actionlink" onclick="loadContributions('discussions')">حاشیے</a></div>
                        <div class="poemtablinks" id="recitations"><a role="button" class="actionlink" onclick="loadContributions('recitations')">قرأتیں</a></div>
                        <div class="poemtablinks" id="museumlinks"><a role="button" class="actionlink" onclick="loadContributions('museumlinks')">عجائب خانے کے روابط</a></div>
                        <div class="poemtablinks" id="pinterestlinks"><a role="button" class="actionlink" onclick="loadContributions('pinterestlinks')">بیرونی تصاویر</a></div>
                        <div class="poemtablinks" id="poetspeclines"><a role="button" class="actionlink" onclick="loadContributions('poetspeclines')">شعرا کے نکات</a></div>
                        <div class="poemtablinks" id="poetpix"><a role="button" class="actionlink" onclick="loadContributions('poetpix')">تصاویر</a></div>
                        <div class="poemtablinks" id="usernotes"><a role="button" class="actionlink" onclick="loadContributions('usernotes')">عجائب خانے کے نوٹ</a></div>
                        <div class="poemtablinks" id="users"><a role="button" class="actionlink" onclick="loadContributions('users')">صارفین</a></div>
                    </div>
                    <div id="days-placeholder">
                    </div>
                </div>

            </div>


            <partial name="_FooterPartial" model=@(new _FooterPartialModel(){StickyEnabled = true}) />

        </div>



        @if (ViewData["TrackingScript"] != null && !string.IsNullOrEmpty(ViewData["TrackingScript"].ToString()))
        {
            @Html.Raw(ViewData["TrackingScript"])
        }

    }

    <script>
        loadContributions('poemcorrections');
    </script>


