@page
@model DivanRazor.Pages.RandomModel
@{
    Layout = null;
    ViewData["Title"] = "اتفاقی شعر";
}
<!DOCTYPE html>
<html lang="ur-PK" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="/css/r4.css?version=2" rel="stylesheet" type="text/css" />
    <script type="text/javascript" src="/js/r2.js"></script>
</head>
<body id="tb">
    <div id="content">
        <div id="divan">
            @if (Model.Poem != null)
            {
                @* first couplet (or first two lines) of a random poem *@
                foreach (var verse in Model.Poem.Verses.Take(2))
                {
                    <p>@verse.Text</p>
                }
                <p><a href="@Model.Poem.FullUrl" target="_top">@Model.Poem.Category?.Poet?.Nickname</a></p>
            }
        </div>
    </div>
    <div id="footer">
        <p>
            <a class="cursor-pointer" role="button" onclick="window.location.reload()">ایک اور شعر</a>
        </p>
        <p>
            مکمل شعر پڑھنے کے لیے شاعر کے نام پر کلک کریں.
        </p>
        <p>
        </p>
    </div>

    @if (ViewData["TrackingScript"] != null && !string.IsNullOrEmpty(ViewData["TrackingScript"].ToString()))
    {
        @Html.Raw(ViewData["TrackingScript"])
    }

</body>
</html>