@* divan: Urdu fonts (Naskh default / Nastaliq option) + overrides, included in every page <head> after p8.css *@
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400..700&family=Noto+Naskh+Arabic:wght@400..700&display=swap" rel="stylesheet" />
<link href="~/css/divan.css" asp-append-version="true" rel="stylesheet" type="text/css" />
<script>
    // divan: Naskh (default) / Nastaliq font choice, applied before render to avoid a flash
    try { if (localStorage.getItem("divan-font") === "nastaliq") document.documentElement.classList.add("font-nastaliq"); } catch (e) { }
    function toggleDivanFont() {
        var nastaliq = document.documentElement.classList.toggle("font-nastaliq");
        try { localStorage.setItem("divan-font", nastaliq ? "nastaliq" : "naskh"); } catch (e) { }
        var t = document.getElementById("font-toggle");
        if (t) t.textContent = nastaliq ? "نستعلیق" : "نسخ";
    }
</script>
