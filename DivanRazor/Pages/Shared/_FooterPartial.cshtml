<div id="changelog-modal" class="modal">
    <span onclick="document.getElementById('changelog-modal').style.display='none'"
          class="close" title="بند کریں">&times;</span>
    <div class="modal-content animate changelog-modal-content">
        <h2 class="changelog-title">دیوان میں نیا کیا ہے</h2>
        <div id="changelog-list" class="changelog-list">
            <div class="changelog-loading">لوڈ ہو رہا ہے...</div>
        </div>
    </div>
</div>

<script>
    var changelogLoaded = false;

    function openChangelogModal() {
        document.getElementById('changelog-modal').style.display = 'block';
        if (!changelogLoaded) {
            loadChangelog();
        }
    }

    function loadChangelog() {
        var listEl = document.getElementById('changelog-list');
        fetch('/json/changelog.json', { cache: 'no-store' })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error('network response was not ok');
                }
                return response.json();
            })
            .then(function (items) {
                changelogLoaded = true;
                if (!items || items.length === 0) {
                    listEl.innerHTML = '<div class="changelog-loading">دکھانے کے لیے کچھ نہیں۔</div>';
                    return;
                }
                // newest first
                var reversed = items.slice().reverse();
                var html = '';
                for (var i = 0; i < reversed.length; i++) {
                    var item = reversed[i];
                    html += '<div class="changelog-item">'
                        + '<span class="changelog-date">' + toPersianNumber(item.date) + '</span>'
                        + '<span class="changelog-desc">' + item.description + '</span>'
                        + '</div>';
                }
                listEl.innerHTML = html;
            })
            .catch(function () {
                listEl.innerHTML = '<div class="changelog-loading">تبدیلیوں کی فہرست لوڈ نہیں ہو سکی۔</div>';
            });
    }
</script>

