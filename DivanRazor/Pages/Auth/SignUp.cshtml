@page
@model DivanRazor.Pages.SignUpModel
@{
    Layout = null;

}
<!DOCTYPE html>
<html lang="ur-PK" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="shortcut icon" href="/favicon.ico?version=1" type="image/x-icon" />
    <link href="~/css/p8.css" asp-append-version="true" rel="stylesheet" type="text/css" />
    <partial name="_DivanHead" />
</head>
<body class="bk-background">
    <div id="hdr">
        <h1><a href="/" title="دیوان"><span class="divan-wordmark divan-wordmark--sm">دیوان</span></a></h1>
    </div>
    <div id="login">
        <div id="main">
            @if (Model.LoggedIn)
            {
                <div class="background-red color-white">
                    <p>آپ پہلے سے رکن ہیں!</p>
                </div>
            }
            else
            if (Model.SignupPhase1)
            {
                <form method="post" action="/signup?Handler=Phase1">
                    @Html.AntiForgeryToken()
                    <table class="font-size-1em">

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">ای میل: </span>
                            </td>
                            <td class="noborder">
                                <input type="email" asp-for="SignUpViewModel.Email" class="signupemail" placeholder="ای میل" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder" colspan="2">
                                <div class="notice width-100per">
                                    <p>
                                        دیوان کی رکنیت کے لیے ای میل درکار ہے۔ رکنیت کا عمل آپ کی ای میل پر ایک کوڈ بھیج کر آگے بڑھتا ہے؛ اگر ای میل درست نہ ہو یا آپ کو اس تک رسائی نہ ہو تو رکنیت ممکن نہیں.
                                    </p>
                                </div>
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">حفاظتی تصویر:</span>
                            </td>
                            <td class="noborder">
                                <img src="@Model.CaptchaImageUrl" alt="حفاظتی تصویر" width="100" />
                                <input type="hidden" asp-for="SignUpViewModel.ClientAppName" />
                                <input type="hidden" asp-for="SignUpViewModel.Language" />
                                <input type="hidden" asp-for="SignUpViewModel.CallbackUrl" />
                                <input type="hidden" asp-for="SignUpViewModel.CaptchaImageId" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder" colspan="2">
                                <div class="notice width-100per">
                                    <p>
                                        اوپر کی حفاظتی تصویر حقیقی صارفین اور خودکار پروگراموں میں فرق کرنے میں مدد دیتی ہے۔ براہِ کرم تصویر میں نظر آنے والا عدد نیچے کے خانے میں لکھیں:
                                    </p>
                                </div>

                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">حفاظتی تصویر کا عدد: </span>
                            </td>
                            <td class="noborder">
                                <input asp-for="SignUpViewModel.CaptchaValue" class="signupemail" placeholder="حفاظتی تصویر کا عدد" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder" colspan="2"><input type="submit" name="submit" id="submit" class="pagebutton font-size-2em background-green width-100per padding-bottom-50px" value="جاری رکھیں" /></td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder" colspan="2">
                                <div class="background-red color-white"><p>@Model.LastError</p></div>
                                <div class="notice width-100per">
                                    <p>براہِ کرم ان نکات پر دھیان دیں:</p>
                                    <p>۱. اگر آپ پہلے سے دیوان کے رکن ہیں تو انہی معلومات سے داخل ہوں؛ اسی ای میل سے دوبارہ رکنیت ممکن نہیں. </p>
                                    <p>۲. اشعار پڑھنے کے لیے رکنیت ضروری نہیں؛ حاشیہ لکھنے اور سائٹ میں حصہ لینے کے لیے رکنیت درکار ہے.</p>
                                    <p>۳. دیوان یہ معلومات جمع نہیں کرتا کہ آپ اپنے اکاؤنٹ سے کون سے صفحات پڑھتے ہیں۔ اطمینان کے لیے <a href="/privacy">رازداری</a> کا صفحہ پڑھ لیں.</p>
                                    <p>۴. رکنیت کے بعد آپ اپنا اکاؤنٹ حذف کر سکتے ہیں؛ اس سے آپ کے حاشیے اور قرأتیں حذف ہو جائیں گی اور ترامیم جیسی شراکتیں دیوان کے نظامی صارف کے نام منتقل ہو جائیں گی.</p>
                                </div>
                            </td>
                        </tr>

                    </table>

                </form>

            }
            else
            if (Model.SignupVerifyEmailPhase)
            {
                <form method="post" action="/signup?Handler=Phase2">
                    @Html.AntiForgeryToken()
                    <table class="font-size-1em">

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">موصولہ کوڈ:</span>
                            </td>
                            <td class="noborder">
                                <input asp-for="Secret" class="signupemail" placeholder="موصولہ کوڈ" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder" colspan="2">
                                <div class="notice width-100per">
                                    <p>براہِ کرم اپنی ای میل دیکھیں۔ اگر پتا درست لکھا تھا تو دیوان کی طرف سے ایک کوڈ والی ای میل آئی ہوگی. </p>
                                    <p>موصولہ کوڈ اوپر کے خانے میں لکھ کر «جاری رکھیں» دبائیں.</p>
                                    <p><span class="red-color">یاد دہانی:</span> ممکن ہے ای میل اسپام فولڈر میں چلی گئی ہو.</p>
                                </div>
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder"><a role="button" class="pagebutton" href="/signup">پچھلا مرحلہ</a></td>
                            <td class="noborder"><input type="submit" name="submit" id="submit" class="pagebutton font-size-2em background-green width-100per padding-bottom-50px" value="جاری رکھیں" /></td>
                        </tr>

                    </table>

                    <div class="background-red color-white"><p>@Model.LastError</p></div>
                </form>
            }
            else
            {
                <form method="post" action="/signup?Handler=Phase3">
                    @Html.AntiForgeryToken()
                    <table class="font-size-1em">

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">نام: </span>
                            </td>
                            <td class="noborder">
                                <input asp-for="FinalViewModel.FirstName" class="rtl-right width-100per" placeholder="نام" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">خاندانی نام: </span>
                            </td>
                            <td class="noborder">
                                <input asp-for="FinalViewModel.SurName" class="rtl-right width-100per" placeholder="خاندانی نام" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">پاس ورڈ: </span>
                            </td>
                            <td class="noborder">
                                <input asp-for="FinalViewModel.Password" id="password" class="signupemail" placeholder="پاس ورڈ" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">پاس ورڈ دوبارہ: </span>
                            </td>
                            <td class="noborder">
                                <input asp-for="FinalViewModel.PasswordConfirmation" class="signupemail" placeholder="پاس ورڈ دوبارہ" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder" colspan="2">
                                <input type="hidden" asp-for="FinalViewModel.Email" />
                                <input type="hidden" asp-for="FinalViewModel.Secret" />
                                <div class="notice width-100per">
                                    <p>پاس ورڈ میں کم از کم <span class="red-color"><strong>۶</strong></span> حروف ہوں اور یہ <span class="red-color"><strong>اعداد اور انگریزی حروف</strong></span> کے امتزاج سے بنا ہو.</p>
                                    <p>حروف اور اعداد مکرر نہ ہوں اور <span class="red-color"><strong>کم از کم ایک عدد</strong></span> و <span class="red-color"><strong>ایک چھوٹا انگریزی حرف</strong></span> پاس ورڈ میں لازمی ہے.</p>
                                </div>
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder" colspan="2"><input type="submit" name="submit" id="submit" class="pagebutton font-size-2em background-green width-100per padding-bottom-50px" value="جاری رکھیں" /></td>
                        </tr>

                    </table>

                    <div class="background-red color-white"><p>@Model.LastError</p></div>
                </form>

            }

        </div>
        <partial name="_FooterPartial" model=@(new _FooterPartialModel(){StickyEnabled = false}) />
    </div>
    @if (ViewData["TrackingScript"] != null && !string.IsNullOrEmpty(ViewData["TrackingScript"].ToString()))
    {
        @Html.Raw(ViewData["TrackingScript"])
    }

</body>
</html>