@page
@model DivanRazor.Pages.ResetPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ur-PK" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="shortcut icon" href="/favicon.ico?version=1" type="image/x-icon" />
    <link href="~/css/p8.css" asp-append-version="true" rel="stylesheet" type="text/css" />
    <partial name="_DivanHead" />
</head>
<body class="bk-background">
    <div id="hdr">
        <h1><a href="/" title="دیوان"><span class="divan-wordmark divan-wordmark--sm">دیوان</span></a></h1>
    </div>
    <div id="login">
        <div id="main">
            @if (Model.LoggedIn)
            {
                <div class="background-red color-white">
                    <p>آپ پہلے سے داخل ہیں! پاس ورڈ کی بازیابی کے لیے پہلے خروج کریں.</p>
                </div>
            }
            else
            if (Model.PhaseSendEmail)
            {
                <form method="post" action="/resetpassword?Handler=SendEmail">
                    @Html.AntiForgeryToken()

                    <table class="font-size-1em">

                        <tr class="nobackground">
                            <td class="noborder" colspan="2">
                                <div class="notice width-100per">
                                    <p>
                                        براہِ کرم وہ ای میل لکھیں جس سے آپ نے رکنیت لی تھی:
                                    </p>
                                </div>

                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">ای میل: </span>
                            </td>
                            <td class="noborder">
                                <input type="email" asp-for="ForgotPasswordViewModel.Email" class="signupemail" placeholder="ای میل" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">حفاظتی تصویر:</span>
                            </td>
                            <td class="noborder">
                                <img src="@Model.CaptchaImageUrl" alt="حفاظتی تصویر" width="100" />
                                <input type="hidden" asp-for="ForgotPasswordViewModel.ClientAppName" />
                                <input type="hidden" asp-for="ForgotPasswordViewModel.Language" />
                                <input type="hidden" asp-for="ForgotPasswordViewModel.CallbackUrl" />
                                <input type="hidden" asp-for="ForgotPasswordViewModel.CaptchaImageId" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder" colspan="2">
                                <div class="notice width-100per">
                                    <p>
                                        اوپر کی حفاظتی تصویر حقیقی صارفین اور خودکار پروگراموں میں فرق کرنے میں مدد دیتی ہے۔ براہِ کرم تصویر میں نظر آنے والا عدد نیچے کے خانے میں لکھیں:
                                    </p>
                                </div>
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">حفاظتی تصویر کا عدد: </span>
                            </td>
                            <td class="noborder">
                                <input asp-for="ForgotPasswordViewModel.CaptchaValue" class="signupemail" placeholder="حفاظتی تصویر کا عدد" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder" colspan="2"><input type="submit" name="submit" id="submit" class="pagebutton font-size-2em background-green width-100per padding-bottom-50px" value="جاری رکھیں" /></td>
                        </tr>
                    </table>

                    <div class="background-red color-white"><p>@Model.LastError</p></div>

                </form>
            }
            else
            if (Model.PhaseVerify)
            {
                <form method="post" action="/resetpassword?Handler=Verify">
                    @Html.AntiForgeryToken()

                    <table class="font-size-1em">

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">موصولہ کوڈ:</span>
                            </td>
                            <td class="noborder">
                                <input asp-for="Secret" class="signupemail" placeholder="موصولہ کوڈ" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder" colspan="2">
                                <div class="notice width-100per">
                                    <p>براہِ کرم اپنی ای میل دیکھیں۔ اگر پتا درست لکھا تھا تو دیوان کی طرف سے ایک کوڈ والی ای میل آئی ہوگی. </p>
                                    <p>موصولہ کوڈ اوپر کے خانے میں لکھ کر «جاری رکھیں» دبائیں.</p>
                                    <p><span class="red-color">یاد دہانی:</span> ممکن ہے ای میل اسپام فولڈر میں چلی گئی ہو.</p>
                                </div>
                            </td>
                        </tr>


                        <tr class="nobackground">
                            <td class="noborder"><a role="button" class="pagebutton" href="/resetpassword">پچھلا مرحلہ</a></td>
                            <td class="noborder"><input type="submit" name="submit" id="submit" class="pagebutton font-size-2em background-green width-100per padding-bottom-50px" value="جاری رکھیں" /></td>
                        </tr>

                    </table>

                    <div class="background-red color-white"><p>@Model.LastError</p></div>

                </form>
            }
            else
            {
                <form method="post" action="/resetpassword?Handler=Phase3">
                    @Html.AntiForgeryToken()

                    <table class="font-size-1em">

                        <tr class="nobackground">
                            <td class="noborder" colspan="2">
                                <div class="notice width-100per">
                                    <p>نیا پاس ورڈ مقرر کریں:</p>
                                </div>
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">پاس ورڈ: </span>
                            </td>
                            <td class="noborder">
                                <input asp-for="ResetPasswordViewModel.Password" id="password" class="signupemail" autocomplete="new-password" placeholder="پاس ورڈ" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder">
                                <span class="inputlabel">پاس ورڈ دوبارہ: </span>
                            </td>
                            <td class="noborder">
                                <input asp-for="ResetPasswordViewModel.PasswordConfirmation" class="signupemail" autocomplete="new-password" placeholder="پاس ورڈ دوبارہ" />
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder" colspan="2">
                                <input type="hidden" asp-for="ResetPasswordViewModel.Email" />
                                <input type="hidden" asp-for="ResetPasswordViewModel.Secret" />
                                <div class="notice width-100per">
                                    <p>پاس ورڈ میں کم از کم <span class="red-color"><strong>۶</strong></span> حروف ہوں اور یہ <span class="red-color"><strong>اعداد اور انگریزی حروف</strong></span> کے امتزاج سے بنا ہو.</p>
                                    <p>حروف اور اعداد مکرر نہ ہوں اور <span class="red-color"><strong>کم از کم ایک عدد</strong></span> و <span class="red-color"><strong>ایک چھوٹا انگریزی حرف</strong></span> پاس ورڈ میں لازمی ہے.</p>
                                </div>
                            </td>
                        </tr>

                        <tr class="nobackground">
                            <td class="noborder" colspan="2"><input type="submit" name="submit" class="pagebutton font-size-2em background-green width-100per padding-bottom-50px" id="submit" value="جاری رکھیں" /></td>
                        </tr>

                    </table>

                    <div class="background-red color-white"><p>@Model.LastError</p></div>
                </form>
            }
        </div>
        <partial name="_FooterPartial" model=@(new _FooterPartialModel(){StickyEnabled = false}) />
    </div>
    @if (ViewData["TrackingScript"] != null && !string.IsNullOrEmpty(ViewData["TrackingScript"].ToString()))
    {
        @Html.Raw(ViewData["TrackingScript"])
    }

</body>
</html>