@model DivanRazor.Pages._QuotedPoemPartialModel
@using DNTPersianUtils.Core
@{
    Layout = null;
}

<div class="@Model.BlockClass">
    @if(Model.DivanQuotedPoemViewModel.ClaimedByBothPoets)
    {
        <div class="ribbon">منتسب به هر دو سخنور</div>
    }
    
    @if (Model.DivanQuotedPoemViewModel.IsPriorToRelated)
    {
        <div class="poet-pic-wrap">
            <img src="@(DivanRazor.APIRoot.InternetUrl + Model.PoetImageUrl)" alt="@Model.PoetNickName">
        </div>
        <div class="simitext">
            <p>
                <a href="#bn@(Model.DivanQuotedPoemViewModel.CoupletIndex + 1)">
                    <strong>
                        همین شعر » بیت @((Model.DivanQuotedPoemViewModel.CoupletIndex + 1).ToPersianNumbers())
                    </strong>
                </a>
            </p>
            <p>

                @if (Model.DivanQuotedPoemViewModel.CoupletVerse1ShouldBeEmphasized)
                {
                    <strong>@Model.DivanQuotedPoemViewModel.CoupletVerse1</strong>

                }
                else
                {
                    @Model.DivanQuotedPoemViewModel.CoupletVerse1
                }
            </p>
            <p>
                @if (Model.DivanQuotedPoemViewModel.CoupletVerse2ShouldBeEmphasized)
                {
                    <strong>@Model.DivanQuotedPoemViewModel.CoupletVerse2</strong>

                }
                else
                {
                    @Model.DivanQuotedPoemViewModel.CoupletVerse2
                }
            </p>

        </div>

        <div class="poet-pic-wrap">
            @if(string.IsNullOrEmpty(Model.DivanQuotedPoemViewModel.CachedRelatedPoemPoetImage))
            {
                <img src="/image/unknown.gif" alt="@Model.DivanQuotedPoemViewModel.CachedRelatedPoemPoetName" />
            }
            else
            {
                <a href="@Html.Raw(Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullUrl)"><img src="@(DivanRazor.APIRoot.InternetUrl +  Model.DivanQuotedPoemViewModel.CachedRelatedPoemPoetImage)" alt="@Model.DivanQuotedPoemViewModel.CachedRelatedPoemPoetName"></a>
            }
            
        </div>
        <div class="inlinesimi-poem-title">
            @if (string.IsNullOrEmpty(Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullUrl))
            {
                <strong>
                    @Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullTitle
                </strong>
            }
            else if (Model.DivanQuotedPoemViewModel.RelatedCoupletIndex != null)
            {
                <a href="@Html.Raw(Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullUrl)#bn@(Model.DivanQuotedPoemViewModel.RelatedCoupletIndex + 1)">
                    @(Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullTitle + " » بیت " + ((Model.DivanQuotedPoemViewModel.RelatedCoupletIndex + 1).ToPersianNumbers()))
                </a>
            }
            else
            {
                <a href="@Html.Raw(Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullUrl)">
                    @Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullTitle
                </a>
            }

        </div>
        <div class="simitext">
            <p>

                @if (Model.DivanQuotedPoemViewModel.RelatedCoupletVerse1ShouldBeEmphasized)
                {
                    <strong>@Model.DivanQuotedPoemViewModel.RelatedCoupletVerse1</strong>
                }
                else
                {
                    @Model.DivanQuotedPoemViewModel.RelatedCoupletVerse1
                }
            </p>
            <p>
                @if (Model.DivanQuotedPoemViewModel.RelatedCoupletVerse2ShouldBeEmphasized)
                {
                    <strong>@Model.DivanQuotedPoemViewModel.RelatedCoupletVerse2</strong>
                }
                else
                {
                    @Model.DivanQuotedPoemViewModel.RelatedCoupletVerse2
                }
            </p>
        </div>
    }
    else
    {
        <div class="poet-pic-wrap">
            @if (string.IsNullOrEmpty(Model.DivanQuotedPoemViewModel.CachedRelatedPoemPoetImage))
            {
                <img src="/image/unknown.gif" alt="@Model.DivanQuotedPoemViewModel.CachedRelatedPoemPoetName" />
            }
            else
            {
                <a href="@Html.Raw(Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullUrl)"><img src="@(DivanRazor.APIRoot.InternetUrl +  Model.DivanQuotedPoemViewModel.CachedRelatedPoemPoetImage)" alt="@Model.DivanQuotedPoemViewModel.CachedRelatedPoemPoetName"></a>
            }
        </div>
        <div class="inlinesimi-poem-title">
            @if (string.IsNullOrEmpty(Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullUrl))
            {
                <strong>
                    @Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullTitle
                </strong>
            }
            else if (Model.DivanQuotedPoemViewModel.RelatedCoupletIndex != null)
            {
                <a href="@Html.Raw(Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullUrl)#bn@(Model.DivanQuotedPoemViewModel.RelatedCoupletIndex + 1)">
                    @(Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullTitle + " » بیت " + ((Model.DivanQuotedPoemViewModel.RelatedCoupletIndex + 1).ToPersianNumbers()))
                </a>
            }
            else
            {
                <a href="@Html.Raw(Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullUrl)">
                    @Model.DivanQuotedPoemViewModel.CachedRelatedPoemFullTitle
                </a>
            }

        </div>
        <div class="simitext">
            <p>

                @if (Model.DivanQuotedPoemViewModel.RelatedCoupletVerse1ShouldBeEmphasized)
                {
                    <strong>@Model.DivanQuotedPoemViewModel.RelatedCoupletVerse1</strong>
                }
                else
                {
                    @Model.DivanQuotedPoemViewModel.RelatedCoupletVerse1
                }
            </p>
            <p>
                @if (Model.DivanQuotedPoemViewModel.RelatedCoupletVerse2ShouldBeEmphasized)
                {
                    <strong>@Model.DivanQuotedPoemViewModel.RelatedCoupletVerse2</strong>
                }
                else
                {
                    @Model.DivanQuotedPoemViewModel.RelatedCoupletVerse2
                }
            </p>
        </div>

        <div class="poet-pic-wrap">
            <img src="@(DivanRazor.APIRoot.InternetUrl + Model.PoetImageUrl)" alt="@Model.PoetNickName">
        </div>
        <div class="simitext">
            <p>
                <a href="#bn@(Model.DivanQuotedPoemViewModel.CoupletIndex + 1)">
                    <strong>
                        همین شعر » بیت @((Model.DivanQuotedPoemViewModel.CoupletIndex + 1).ToPersianNumbers())
                    </strong>
                </a>
            </p>
            <p>

                @if (Model.DivanQuotedPoemViewModel.CoupletVerse1ShouldBeEmphasized)
                {
                    <strong>@Model.DivanQuotedPoemViewModel.CoupletVerse1</strong>

                }
                else
                {
                    @Model.DivanQuotedPoemViewModel.CoupletVerse1
                }
            </p>
            <p>
                @if (Model.DivanQuotedPoemViewModel.CoupletVerse2ShouldBeEmphasized)
                {
                    <strong>@Model.DivanQuotedPoemViewModel.CoupletVerse2</strong>

                }
                else
                {
                    @Model.DivanQuotedPoemViewModel.CoupletVerse2
                }
            </p>

        </div>


    }

    @if (Model.DivanQuotedPoemViewModel.ChosenForMainList && Model.DivanQuotedPoemViewModel.SamePoemsQuotedCount > 1)
    {
        <a role="button" class="pagebutton" id="@($"load-more-quoted-button-{Model.DivanQuotedPoemViewModel.Id}")" onclick="loadMoreQuotedForRelatedPoem('@Model.DivanQuotedPoemViewModel.Id', @Model.DivanQuotedPoemViewModel.PoemId, @Model.DivanQuotedPoemViewModel.RelatedPoemId, '@Model.PoetImageUrl', '@Model.PoetNickName', @Model.CanEdit.ToString().ToLower())">مشاهدهٔ @((Model.DivanQuotedPoemViewModel.SamePoemsQuotedCount - 1).ToPersianNumbers()) نقل قول دیگر در همین شعر<i class="notranslate info-buttons autorenew"></i></a>
    }

    @if (Model.DivanQuotedPoemViewModel.ClaimedByBothPoets)
    {
        <div class="century-alt">
            <a href="/faq?id=7">چطور یک شعر می‌تواند به چند شاعر منتسب باشد؟</a>
        </div>
    }
    

    @if(!string.IsNullOrEmpty(Model.DivanQuotedPoemViewModel.Note))
    {
        <div class="notice">
            @Html.Raw(Model.DivanQuotedPoemViewModel.Note)
        </div>
    }



    @if (Model.CanEdit)
    {
        <a href="/Admin/EditQuoted/?p=@Model.DivanQuotedPoemViewModel.PoemId&id=@Model.DivanQuotedPoemViewModel.Id" class="pagebutton comments-link">ویرایش</a>
    }

</div>

@if (Model.DivanQuotedPoemViewModel.ChosenForMainList && Model.DivanQuotedPoemViewModel.SamePoemsQuotedCount > 1)
{
    <div id=@($"more-quoted-placeholder-{Model.DivanQuotedPoemViewModel.Id}")></div>
}


