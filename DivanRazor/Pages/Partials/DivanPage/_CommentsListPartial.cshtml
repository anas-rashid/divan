@model DivanRazor.Pages._CommentsListPartialModel
@using DNTPersianUtils.Core
@{
    Layout = null;
}

@switch (Model.Comments.Length)
{
    case 0:
        <p>
            اس شعر پر ابھی کوئی حاشیہ نہیں لکھا گیا. <a href="#commentform" class="comments-link" title="میں حاشیہ لکھوں ...">💬 میں حاشیہ لکھوں ...</a>
        </p>
        break;
    case 1:
        <p>
            اس شعر پر اب تک ایک حاشیہ لکھا گیا ہے. <a href="#commentform" class="comments-link" title="میں حاشیہ لکھوں ...">💬 میں حاشیہ لکھوں ...</a>
        </p>
        break;
    default:
        <p>
            اب تک @Html.Raw(Model.Comments.Length.ToPersianNumbers()) حاشیے اس شعر پر لکھے گئے ہیں. <a href="#commentform" class="comments-link" title="میں حاشیہ لکھوں ...">💬 میں حاشیہ لکھوں ...</a>
        </p>
        break;
}

<div id="comments-block">
    @foreach (var comment in Model.Comments)
    {
        <partial name="~/Pages/Partials/DivanPage/_CommentPartial.cshtml" model=Model.GetCommentModel(comment) />
    }
</div>
