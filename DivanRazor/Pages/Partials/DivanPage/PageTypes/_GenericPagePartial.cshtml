@model DivanPageModel

<div class="@Model.PoemBlockClass" id="post-@Html.Raw(Model.DivanPage.Id.ToString())">
    <article id="garticle">
        @if (Model.DivanPage.PoetOrCat == null)
        {
            <h2>
                <a href="@Html.Raw(Model.Request.Path)" rel="bookmark">
                    @Model.DivanPage.FullTitle
                </a>
            </h2>
        }
        else
        {
            <div class="spacer">&nbsp;</div>
            @if (Model.DivanPage.SecondPoet != null)
            {
                <div id="poets">
                    <a href="@Html.Raw(Model.DivanPage.PoetOrCat.Poet.FullUrl)">
                        <img src="@(DivanRazor.APIRoot.InternetUrl + Model.DivanPage.PoetOrCat.Poet.ImageUrl)" alt="@Html.Raw(Model.DivanPage.PoetOrCat.Poet.Nickname)" class="poets-poet">
                    </a>
                    <a href="@Html.Raw(Model.DivanPage.SecondPoet.FullUrl)">
                        <img src="@(DivanRazor.APIRoot.InternetUrl + Model.DivanPage.SecondPoet.ImageUrl)" alt="@Html.Raw(Model.DivanPage.SecondPoet.Nickname)" class="poets-poet">
                    </a>
                </div>
                <div id="page-hierarchy">
                    <a href="@Html.Raw(Model.DivanPage.PoetOrCat.Poet.FullUrl)">@Html.Raw(Model.DivanPage.PoetOrCat.Poet.Nickname)</a>
                    <span> &raquo;</span>
                    <h2><a href="@Html.Raw(Model.DivanPage.FullUrl)">@Html.Raw(Model.DivanPage.Title)</a></h2>
                </div>
            }
            else
            {
                <div id="poet-image">
                    <a href="@Html.Raw(Model.DivanPage.PoetOrCat.Poet.FullUrl)">
                        <img src="@(DivanRazor.APIRoot.InternetUrl + Model.DivanPage.PoetOrCat.Poet.ImageUrl)" alt="@Html.Raw(Model.DivanPage.PoetOrCat.Poet.Nickname)">
                    </a>
                </div>
                <div id="page-hierarchy" class="width-100per margin-auto">
                    @{
                        foreach (var gran in Model.DivanPage.PoetOrCat.Cat.Ancestors)
                        {
                            <a href="@Html.Raw(gran.FullUrl)">@Html.Raw(gran.Title)</a>
                            <span> &raquo;</span>
                        }
                        <a href="@Html.Raw(Model.DivanPage.PoetOrCat.Cat.FullUrl)">@Html.Raw(Model.DivanPage.PoetOrCat.Cat.Title)</a>
                        <text> &raquo; </text>
                        <h2>
                            <a href="@Html.Raw(Model.DivanPage.FullUrl)" rel="bookmark">
                                @Html.Raw(Model.DivanPage.Title)
                            </a>
                        </h2>
                    }
                </div>
            }
        }

        <partial name="~/Pages/Partials/DivanPage/_InlinePageUtilsPartial.cshtml" model="Model" />
        @Html.Raw(Model.DivanPage.HtmlText)

        @if (Model.DivanPage.Id == DivanPageModel.DivanSlashVaznPageId)
        {
            <div class="poempretab" id="wordcounts-placeholder-tab-items"></div>
            <div class="poemtab">
                <div class="poemtablinks"><a href="#pretab">شعرا</a></div>
                <div class="poemtablinks"><a href="#langs-stats-tab-items">زبانیں</a></div>
                <div class="poemtablinks"><a href="#formats-stats-tab-items">اصناف</a></div>
                <div class="poemtablinks"><a href="#rhyhtms-stats-tab-items">بحریں</a></div>
                <div class="poemtablinks"><a href="#couplets-stats-tab-items">اشعار کی تعداد</a></div>
                <div class="poemtablinks active"><a href="#wordcounts-placeholder-tab-items">الفاظ کی تعداد</a></div>
            </div>

            <div id="wordcounts-placeholder">
                @if (Model.CategoryWordsCounts != null)
                {
                    <partial name="~/Pages/Partials/DivanPage/_CategoryWordsCountPartial.cshtml" model="Model.CategoryWordsCounts" />
                }
            </div>
        }
    </article>

    @* Navigation *@
    @if (!string.IsNullOrEmpty(Model.NextUrl) || !string.IsNullOrEmpty(Model.PreviousUrl))
    {
        <div class="spacer">&nbsp;</div>
        <nav id="nav">
            <div class="navigation">
                <div class="navleft">
                    @if (!string.IsNullOrEmpty(Model.NextUrl))
                    {
                        <a href="@Html.Raw(Model.NextUrl)">@Model.NextTitle</a>
                        <span> &raquo;</span>
                    }
                </div>
                <div class="navright">
                    @if (!string.IsNullOrEmpty(Model.PreviousUrl))
                    {
                        <span>&laquo; </span>
                        <a href="@Html.Raw(Model.PreviousUrl)">@Model.PreviousTitle</a>
                    }
                </div>
            </div>
        </nav>
        <div class="spacer">&nbsp;</div>
    }

    @if (Model.CanEdit)
    {
        <div class="spacer">&nbsp;</div>
        <div class="related-images-frame">
            <p>
                <a role="button" href="/Admin/ModifyPage?id=@Model.DivanPage.Id" class="pagebutton">براہِ راست ترمیم</a>
            </p>
        </div>
    }
</div>

@if (Model.DivanPage.Id == DivanPageModel.DivanSlashVaznPageId)
{
    <script>
        function asyncStartupLoadWordCounts() {
            return new Promise((resolve, reject) => {
                setTimeout(() => {
                    loadWordCounts(0, 0, false)
                }, 100);
            });
        }

        asyncStartupLoadWordCounts();
    </script>
}