@model DivanRazor.Pages._CategoryWordsCountPartialModel
@using DNTPersianUtils.Core
@{
}

@if (Model.WordCounts.Length > 0)
{
    <h2>
        الفاظ کی تعداد
    </h2>
    <div id="wordcounts-section">
        <p>
            متن میں @Model.ThisPart @RMuseum.Services.Implementation.LanguageUtils.FormatMoney(Model.TotalWordCount) الفاظ شمار کیے ہیں (ہماری تعریفِ <i>لفظ</i> میں سنجیدہ خامیاں ہیں، یہاں دیکھیں)۔ غیر مکرر الفاظ کی تعداد @RMuseum.Services.Implementation.LanguageUtils.FormatMoney(Model.UniqueWordCount) الفاظ ہے.
        </p>
        @if (Model.RemStopWords)
        {
            <p id="remStopWords">حروفِ ربط اور دیگر عام الفاظ سمیت اعداد دیکھنے کے لیے <a href="javascript:reloadWordCounts(@Model.CatId, @Model.PoetId, false)">یہاں</a> کلک کریں.</p>
        }
        else
        {
            <p id="remStopWords">حروفِ ربط اور دیگر عام الفاظ کے بغیر اعداد دیکھنے کے لیے <a href="javascript:reloadWordCounts(@Model.CatId, @Model.PoetId, true)">یہاں</a> کلک کریں.</p>
        }
        <div class="clear-both">
            <input type="text" id="wordcountterm" placeholder="لفظ تلاش کریں" value="" onkeyup="onSearchWordCounts(@Model.CatId, @Model.PoetId, @Model.TotalWordCount)">
        </div>
        <div id="wordcounts-table">
            <partial name="_CategoryWordsCountTablePartial.cshtml" model="Model.TableModel" />
        </div>
    </div>
}