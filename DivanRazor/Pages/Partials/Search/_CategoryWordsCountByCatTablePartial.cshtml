@model DivanRazor.Pages._CategoryWordsCountByCatTablePartialModel
@using System.Globalization
@using DNTPersianUtils.Core

<p>
    «@Model.Term» مجموعی طور پر @RMuseum.Services.Implementation.LanguageUtils.FormatMoney(Model.TotalCount) بار @Model.SectionName آیا ہے.
</p>


@if (Model.WordStats.Length > 0)
{
    <table class="stats" id="words-stats">
        <thead>
            <tr class="h">
                <td class="c1">نمبر</td>
                <td class="c2">حصہ</td>
                <td class="c3">تعداد</td>
                <td class="c4">فیصد حصے کے کل الفاظ میں سے</td>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.WordStats.Length; i++)
            {
                @if (i % 2 == 0)
                {
                    <tr class="e">
                        <td class="c1">@((i + 1).ToPersianNumbers())</td>
                        <td class="c2"><a href="/search?s=@Model.Term&stats=true&author=@Model.WordStats[i].PoetId&cat=@Model.WordStats[i].CatId">@Model.WordStats[i].Name</a></td>
                        <td class="c3">@RMuseum.Services.Implementation.LanguageUtils.FormatMoney(Model.WordStats[i].Count)</td>
                        @if (Model.WordStats[i].TotalWordCount == 0)
                        {
                            <td class="c4"></td>
                        }
                        else
                        {
                            <td class="c4">@((Model.WordStats[i].Count * 100.0 / Model.WordStats[i].TotalWordCount).ToString("N4", new CultureInfo("ur-PK")).ToPersianNumbers())</td>
                        }
                    </tr>

                }
                else
                {
                    <tr>
                        <td class="c1">@((i + 1).ToPersianNumbers())</td>
                        <td class="c2"><a href="/search?s=@Model.Term&stats=true&author=@Model.WordStats[i].PoetId&cat=@Model.WordStats[i].CatId">@Model.WordStats[i].Name</a></td>
                        <td class="c3">@RMuseum.Services.Implementation.LanguageUtils.FormatMoney(Model.WordStats[i].Count)</td>
                        @if (Model.WordStats[i].TotalWordCount == 0)
                        {
                            <td class="c4"></td>
                        }
                        else
                        {
                            <td class="c4">@((Model.WordStats[i].Count * 100.0 / Model.WordStats[i].TotalWordCount).ToString("N4", new CultureInfo("ur-PK")).ToPersianNumbers())</td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
    <p>
        <small><strong>نکتہ:</strong> چوتھا کالم اس لفظ کا فیصد اسی حصے کے کل الفاظ کے لحاظ سے دکھاتا ہے، پوری فہرست کے نہیں؛ اس لیے اس کالم کا مجموعہ بے معنی ہے.</small>
    </p>
}

